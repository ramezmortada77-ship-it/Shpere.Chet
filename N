<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>سفير — Sphere</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    /* الوضع الفاتح الأساسي (Default Light Theme) */
    :root {
      --bg: #FFFFFF;
      --surface: #F0F2F5;
      --card-bg: #FFFFFF;
      --header-bg: #008069;
      --header-text: #FFFFFF;
      --primary: #008069;
      --accent: #25D366;
      --text: #111B21;
      --text-dim: #667781;
      --border: #E9EDEF;
      --chat-hover: #F5F6F6;
      --badge-bg: #25D366;
      --badge-text: #FFFFFF;
    }

    /* الوضع الداكن (Dark Theme) */
    body.dark-theme {
      --bg: #111B21;
      --surface: #202C33;
      --card-bg: #111B21;
      --header-bg: #202C33;
      --header-text: #E9EDEF;
      --primary: #00A884;
      --accent: #00A884;
      --text: #E9EDEF;
      --text-dim: #8696A0;
      --border: #222D34;
      --chat-hover: #202C33;
      --badge-bg: #00A884;
      --badge-text: #111B21;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Tajawal', sans-serif;
      user-select: none;
    }

    body {
      background-color: #E1E1E1;
      color: var(--text);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .app-container {
      width: 100%;
      max-width: 480px;
      height: 100vh;
      background-color: var(--bg);
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
      overflow: hidden;
    }

    /* Header Styling */
    header {
      background-color: var(--header-bg);
      color: var(--header-text);
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: background-color 0.3s;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-title {
      font-size: 20px;
      font-weight: 700;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .icon-btn {
      background: transparent;
      border: none;
      color: var(--header-text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    /* Tabs Styling */
    .tabs {
      display: flex;
      background-color: var(--header-bg);
      border-bottom: 1px solid rgba(0,0,0,0.08);
    }

    .tab {
      flex: 1;
      text-align: center;
      padding: 12px 0;
      font-size: 15px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.7);
      cursor: pointer;
      border-bottom: 3px solid transparent;
      transition: 0.2s;
    }

    .tab.active {
      color: var(--header-text);
      border-bottom-color: #FFFFFF;
    }

    body.dark-theme .tab.active {
      border-bottom-color: var(--primary);
      color: var(--primary);
    }

    /* Search Bar */
    .search-bar {
      padding: 8px 12px;
      background-color: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    .search-box {
      display: flex;
      align-items: center;
      background-color: var(--surface);
      border-radius: 8px;
      padding: 6px 12px;
      gap: 10px;
    }

    .search-input {
      width: 100%;
      border: none;
      background: transparent;
      color: var(--text);
      font-size: 14px;
      outline: none;
    }

    /* Main Content Sections */
    .content-section {
      flex: 1;
      overflow-y: auto;
      display: none;
    }

    .content-section.active {
      display: block;
    }

    /* Item Card */
    .item-card {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      gap: 14px;
      cursor: pointer;
      border-bottom: 1px solid var(--border);
      transition: background-color 0.15s;
    }

    .item-card:hover {
      background-color: var(--chat-hover);
    }

    /* Avatar & Status Rings */
    .avatar-wrapper {
      position: relative;
      width: 50px;
      height: 50px;
    }

    .avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background-color: var(--primary);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 18px;
    }

    .status-ring {
      border: 2px solid var(--primary);
      padding: 2px;
      border-radius: 50%;
    }

    .online-badge {
      width: 12px;
      height: 12px;
      background-color: var(--accent);
      border: 2px solid var(--bg);
      border-radius: 50%;
      position: absolute;
      bottom: 0;
      left: 0;
    }

    .info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .row-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .name {
      font-weight: 700;
      font-size: 16px;
      color: var(--text);
    }

    .time {
      font-size: 12px;
      color: var(--text-dim);
    }

    .row-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .subtitle {
      font-size: 13px;
      color: var(--text-dim);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 260px;
    }

    .badge {
      background-color: var(--badge-bg);
      color: var(--badge-text);
      font-size: 11px;
      font-weight: 700;
      padding: 3px 7px;
      border-radius: 12px;
    }

    /* Section Headers */
    .section-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-dim);
      padding: 12px 16px 6px 16px;
      text-transform: uppercase;
    }

    /* Floating Action Buttons */
    .fab-group {
      position: absolute;
      bottom: 20px;
      left: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: center;
    }

    .fab {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background-color: var(--primary);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 10px rgba(0,0,0,0.25);
      cursor: pointer;
      border: none;
    }

    .fab-mini {
      width: 42px;
      height: 42px;
      background-color: var(--surface);
      color: var(--text);
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- Header -->
    <header>
      <div class="brand">
        <span class="brand-title">سفير</span>
      </div>
      <div class="header-actions">
        <!-- أزرار الواجهة مثل واتساب: كاميرا، بحث، وضع ليلي، قائمة -->
        <button class="icon-btn" id="theme-toggle" title="تبديل المظهر">🌓</button>
        <button class="icon-btn" title="الكاميرا">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path d="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/></svg>
        </button>
        <button class="icon-btn" title="خيارات">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
        </button>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="tabs">
      <div class="tab active" onclick="switchTab('chats', this)">المحادثات</div>
      <div class="tab" onclick="switchTab('status', this)">الحالات</div>
      <div class="tab" onclick="switchTab('channels', this)">القنوات</div>
    </div>

    <!-- Search Bar -->
    <div class="search-bar">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--text-dim)"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" class="search-input" placeholder="بحث...">
      </div>
    </div>

    <!-- Chats Section -->
    <div id="chats" class="content-section active">
      <div class="item-card">
        <div class="avatar-wrapper">
          <div class="avatar" style="background-color: #008069;">أ</div>
          <div class="online-badge"></div>
        </div>
        <div class="info">
          <div class="row-top">
            <span class="name">أحمد محمود</span>
            <span class="time">10:42 م</span>
          </div>
          <div class="row-bottom">
            <span class="subtitle">أهلاً بك! تطبيق سفير يعمل بالوضع الفاتح بنجاح 🟢</span>
            <span class="badge">2</span>
          </div>
        </div>
      </div>

      <div class="item-card">
        <div class="avatar-wrapper">
          <div class="avatar" style="background-color: #007AFF;">م</div>
        </div>
        <div class="info">
          <div class="row-top">
            <span class="name">محمد علي</span>
            <span class="time">08:15 م</span>
          </div>
          <div class="row-bottom">
            <span class="subtitle">تم إرسال الكود الجديد جاهز للتجربة.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Status Section -->
    <div id="status" class="content-section">
      <div class="item-card">
        <div class="avatar-wrapper">
          <div class="avatar" style="background-color: #667781;">+</div>
        </div>
        <div class="info">
          <span class="name">حالاتي</span>
          <span class="subtitle">انقر لإضافة تحديث حالة</span>
        </div>
      </div>

      <div class="section-title">التحديثات الأخيرة</div>

      <div class="item-card">
        <div class="avatar-wrapper status-ring">
          <div class="avatar" style="background-color: #E8A33D;">س</div>
        </div>
        <div class="info">
          <span class="name">سارة أحمد</span>
          <span class="subtitle">منذ 15 دقيقة</span>
        </div>
      </div>
    </div>

    <!-- Channels Section -->
    <div id="channels" class="content-section">
      <div class="section-title">القنوات المقترحة</div>

      <div class="item-card">
        <div class="avatar-wrapper">
          <div class="avatar" style="background-color: #25D366;">📢</div>
        </div>
        <div class="info">
          <div class="row-top">
            <span class="name">قناة التحديثات الرسمية</span>
            <span class="badge" style="background-color: var(--surface); color: var(--primary);">متابعة</span>
          </div>
          <div class="row-bottom">
            <span class="subtitle">مرحباً بكم في القناة الرسمية لتطبيق سفير...</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Buttons -->
    <div class="fab-group">
      <button class="fab">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
      </button>
    </div>
  </div>

  <script>
    // Theme Toggle Function
    const themeBtn = document.getElementById('theme-toggle');
    themeBtn.addEventListener('click', () => {
      document.body.classList.toggle('dark-theme');
    });

    // Tab Switching Function
    function switchTab(tabId, element) {
      document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
      document.querySelectorAll('.content-section').forEach(sec => sec.classList.remove('active'));
      
      element.classList.add('active');
      document.getElementById(tabId).classList.add('active');
    }
  </script>
</body>
</html>
